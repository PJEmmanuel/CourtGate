<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de copia de seguridad para Android 12 (API 31) y posteriores.
   En Android 11 y anteriores se usan las de backup_rules.xml: mantener las dos iguales.
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- Los resultados de Match solo viven en este dispositivo (así lo dice la app) y al borrar
         la cuenta tienen que desaparecer del todo: court_db no entra en ninguna copia. -->
    <cloud-backup>
        <exclude domain="database" path="court_db" />
        <exclude domain="database" path="court_db-wal" />
        <exclude domain="database" path="court_db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="court_db" />
        <exclude domain="database" path="court_db-wal" />
        <exclude domain="database" path="court_db-shm" />
    </device-transfer>
</data-extraction-rules>
