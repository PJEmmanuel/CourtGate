<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de copia de seguridad para Android 11 (API 30) y anteriores.
   En Android 12+ se usan las de data_extraction_rules.xml: mantener las dos iguales.
   https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Los resultados de Match solo viven en este dispositivo (así lo dice la app) y al borrar
         la cuenta tienen que desaparecer del todo: court_db no entra en ninguna copia. -->
    <exclude domain="database" path="court_db" />
    <exclude domain="database" path="court_db-wal" />
    <exclude domain="database" path="court_db-shm" />
</full-backup-content>
